{
  "name": "expediente-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Admisión de expedientes de cliente en sucursal bancaria, con toda la inferencia en el dispositivo.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node ui/servidor.mjs",
    "demo": "node scripts/demo.mjs --limpiar",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test pruebas/*.test.mjs",
    "test:frontera": "node scripts/verificar-frontera.mjs",
    "verify:offline": "unshare -rn bash -c 'node scripts/smoke.mjs'",
    "verify:entrega": "node scripts/verificar-entrega.mjs",
    "metricas": "node scripts/metricas.mjs",
    "metricas:json": "node scripts/metricas.mjs --json",
    "verify:invariantes": "node scripts/verificar-invariantes.mjs",
    "audit:all": "node scripts/audit-all.mjs",
    "casos": "node scripts/casos.mjs"
  },
  "dependencies": {
    "@qvac/sdk": "0.18.2"
  }
}
